# LLM Configuration
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key-here
LLM_MODEL=deepseek-chat

# vLLM (local) Configuration — switch to this for ROCm deployment:
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=TheBloke/WhiteRabbitNeo-33B-AWQ

# Agent Settings
AGENT_MAX_STEPS=25
AGENT_TOOL_TIMEOUT=30

# Docker container names for tool_executor (when local tools absent)
MSF_CONTAINER=sentinel-msf
HYDRA_CONTAINER=sentinel-hydra

# Server
HOST=0.0.0.0
PORT=8000
